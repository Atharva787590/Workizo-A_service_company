# ==============================================================================
# UNNATI Frontend Environment Configuration Template (SIH 2026 Production)
# ==============================================================================

# Backend API Origin (Leave empty to use automatic window.location hostname detection)
VITE_API_ORIGIN=http://127.0.0.1:8000

# Google OAuth2 Client ID for Customer/Worker Social Authentication
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Supabase Project Configuration (Obtained from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Demo Mode Indicator (Defaults to true for offline / jury demo simulation)
VITE_UNNATI_DEMO_MODE=true

