# Copy this file to backend/.env and adjust values.
# SECRET_KEY - generate one for production: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True

# ---- Database -----------------------------------------------------------
# SQLite is the default (no DB server needed). For MySQL: set USE_MYSQL=True and fill the DB_* fields.
USE_MYSQL=False
DB_NAME=unnati_db
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- CORS -----------------------------------------------------------------
# Empty = allow all origins (dev only). Production example:
# CORS_ALLOWED_ORIGINS=http://localhost:5174,https://your-frontend-domain.in
CORS_ALLOWED_ORIGINS=

# ---- Email -----------------------------------------------------------------
# Leave EMAIL_HOST_USER empty to log emails to the console.
# For real mail (e.g. Gmail SMTP): set EMAIL_HOST_USER and EMAIL_HOST_PASSWORD (App Password).
EMAIL_HOST_USER=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Unnati <no-reply@unnati.in>

# ---- Payments (Razorpay test mode) ------------------------------------------
RAZORPAY_KEY_ID=rzp_test_51O2p3D4R5S6T7U
RAZORPAY_KEY_SECRET=dummy_secret_value

# ---- Google OAuth (optional) -------------------------------------------------
GOOGLE_CLIENT_ID=
