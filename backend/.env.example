# ==============================================================================
# UNNATI Backend Environment Configuration Template (SIH 2026 Production)
# ==============================================================================

# Security Settings
# Generate a secure 50+ character key for production
SECRET_KEY=change-me-in-production-use-a-strong-random-secret-key-50-chars-min
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,unnati.coop,api.unnati.coop

# Supabase Authentication (Verify JWT access tokens via JWKS)
SUPABASE_URL=https://your-project-id.supabase.co

# Database Settings (Supabase PostgreSQL / Production Database)
# Recommended: Set DATABASE_URL from Supabase Dashboard -> Settings -> Database -> Connection string -> URI
# Connection Pooler (port 6543 or 5432) or Direct Connection (port 5432):
DATABASE_URL=postgresql://postgres.your-project-id:your_db_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Alternative discrete connection parameters:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres.your-project-id
# DB_PASSWORD=your_db_password
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=6543

# Redis & Django Channels (Optional for single node, recommended for production WebSockets)
# Leave REDIS_HOST commented out to use InMemoryChannelLayer
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Cross-Origin Resource Sharing (CORS) & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://unnati.coop
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://unnati.coop

# SSL & Security Headers (Set to True in HTTPS Production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Google OAuth2 (Optional for demo, required for Google Login)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# SMTP Email Configuration (For transactional notices & receipts)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=notifications@unnati.coop

# Direct Peer Payment Gateways (Advisory & Verification)
# Note: UNNATI is strictly non-custodial; payments settle directly to worker VPAs.
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
